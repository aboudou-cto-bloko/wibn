# Copie ce fichier en .env et renseigne les vraies valeurs.

# Connexion Postgres (Prisma Postgres managé, ou tout Postgres >= 15).
# Créé via `prisma project create` + `prisma postgres create` — voir README.md.
DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Clé privée RSA (PKCS8) qui signe les licences — ne JAMAIS commiter la vraie valeur.
LICENSE_PRIVATE_KEY=""

# Secret admin arbitraire, vérifié via le header x-admin-secret sur
# /api/generate, /api/revoke, et le chemin admin de /api/deactivate.
LICENSE_SERVER_SECRET=""
