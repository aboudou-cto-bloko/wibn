# Copie ce fichier en .env.local pour un run en local hors Docker,
# ou laisse docker-compose lire directement ce fichier (voir README Docker).

# --- Base de données ---
# En local avec docker-compose, ne pas toucher (nom du service = "db").
# Hors Docker : postgresql://wibn:wibn@localhost:5433/wibn
DATABASE_URL="postgresql://wibn:wibn@db:5432/wibn"
# Mettre à "true" uniquement pour une base distante avec TLS (Neon, Vercel Postgres...).
# Laisser vide/absent pour le Postgres local (Docker ou host).
DATABASE_SSL=

# --- Auth (better-auth) ---
# Génère un secret : openssl rand -base64 32
BETTER_AUTH_SECRET="change-me-with-a-real-32-char-secret"
BETTER_AUTH_URL="http://localhost:3001"
NEXT_PUBLIC_APP_URL="http://localhost:3001"

# --- Groq AI (génération d'idées) ---
# Clé gratuite sur https://console.groq.com
GROQ_API_KEY="gsk_xxx"

# --- Premier compte admin (créé automatiquement au démarrage) ---
ADMIN_EMAIL="admin@wibn.local"
ADMIN_PASSWORD="change-me"
ADMIN_NAME="Admin"

NODE_ENV="development"
